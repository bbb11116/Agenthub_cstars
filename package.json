{
  "name": "agenthub-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run rebuild:electron && vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "npm run rebuild:node && vitest run",
    "test:db": "npm run rebuild:node && vitest run src/main/db/dbSmoke.test.ts",
    "test:e2e": "npm run rebuild:node && vitest run tests/e2e/mvpFlow.test.ts",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "node scripts/rebuild-electron-native.cjs",
    "start": "npm run rebuild:electron && electron ."
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^4.1.7"
  }
}
